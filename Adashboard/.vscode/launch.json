{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "▶ Run Allanese Dashboard",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "env": { "PORT": "3000" },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "running on http://0.0.0.0:(\\d+)",
        "uriFormat": "http://localhost:%s"
      }
    }
  ]
}
